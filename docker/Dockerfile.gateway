# docker/Dockerfile.gateway
# Production NGINX Reverse Proxy Container for Project Warden (Tier 6 api-gateway)
FROM nginx:1.25.4-alpine

# Install curl for healthcheck probing
RUN apk add --no-cache curl

# Copy custom NGINX configuration
COPY config/nginx/nginx.conf /etc/nginx/nginx.conf

# Expose HTTP and HTTPS ingress listener ports
EXPOSE 80 443

# Healthcheck validating local origin readiness
HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:80/healthz || exit 1

# Start NGINX in foreground
CMD ["nginx", "-g", "daemon off;"]
